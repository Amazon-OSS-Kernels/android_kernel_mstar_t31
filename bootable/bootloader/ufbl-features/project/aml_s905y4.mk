LOCAL_DIR := $(GET_LOCAL_DIR)
# List of features for this product
FEATURE_FASTBOOT_EXTENSIONS := false
FEATURE_IDME := true
FEATURE_COMMON_OPENSSL := false
FEATURE_LIBTOMCRYPT := true
FEATURE_LIBTOMMATH := true
FEATURE_SECURE_BOOT := true

FEATURE_LK_RAMDUMP := false
FEATURE_LIFE_CYCLE_REASONS := false
FEATURE_UNLOCK := true
FEATURE_FASTBOOT_LOCKDOWN := true
FEATURE_ONETIME_UNLOCK := true

DEFINES += -DUFBL_PLAT_AML_S905Y4
DEFINES += -DUFBL_PLATFORM_AML
DEFINES += -DCONFIG_UFBL
DEFINES += -DUFBL_FEATURE_LIBTOMCRYPT
DEFINES += -DUFBL_FEATURE_LIBTOMMATH
DEFINES += -DUFBL_FEATURE_SECURE_BOOT
DEFINES += -DUFBL_FEATURE_UNLOCK
DEFINES += -DUFBL_FEATURE_FASTBOOT_LOCKDOWN
ifeq ($(FEATURE_ONETIME_UNLOCK),true)
DEFINES += -DUFBL_FEATURE_ONETIME_UNLOCK
endif
DEFINES += -DUFBL_FASTBOOT_RESPONSE

# so we use the last 200 blocks for idme
DEFINES += -DIDME_NUM_OF_EMMC_BLOCKS=200
DEFINES += -DIDME_UPDATE_TABLE=1
export DEFINES FEATURE_SECURE_BOOT FEATURE_LIBTOMCRYPT FEATURE_LIBTOMMATH
KBUILD_CFLAGS += $(DEFINES)
UFBL_PLAT_AML_S905Y4 := yes
export UFBL_PLAT_AML_S905Y4
UFBL_UBOOT_IS_KBUILD := yes
export UFBL_UBOOT_IS_KBUILD

# After defining list of features, include
# ufbl common definitions
include $(LOCAL_DIR)/ufbl_common_uboot.mk
